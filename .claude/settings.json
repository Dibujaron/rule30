{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-title.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-message.sh\""
          }
        ]
      }
    ]
  }
}
